# Ollama handles both chat and embeddings locally or on a Compute Engine VM.
OLLAMA_BASE_URL=http://localhost:11434
# Model chinh thuc cho may test (RTX 5060, 8 GB VRAM). Trong so ~6,14 GB nen
# KHONG vua card 6 GB — bootstrap.ps1 se tu chan va bao ro. May yeu hon thi dat
# OLLAMA_CHAT_MODEL trong terminal (vi du qwen2.5:3b) thay vi sua tep nay.
# So do doi chung cac model: docs/BENCHMARK_RESULTS_20260911.md.
OLLAMA_CHAT_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_KEEP_ALIVE=24h
OLLAMA_EMBED_KEEP_ALIVE=0
OLLAMA_WARMUP_ENABLED=true
OLLAMA_EMBED_BATCH_SIZE=32
OLLAMA_NUM_CTX=4096
OLLAMA_SHORT_NUM_CTX=2048
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_PREDICT=1024
OLLAMA_LONG_NUM_PREDICT=1536
OLLAMA_CONTEXT_RESERVE_TOKENS=128
OLLAMA_THINK=false
API_TIMEOUT_SECONDS=300
API_CONNECT_TIMEOUT_SECONDS=10
API_MAX_CONNECTIONS=20
# One-worker local/ngrok admission control. Multi-worker deployments need a
# corresponding shared or edge limit.
CHAT_MAX_CONCURRENT_REQUESTS=10
CHAT_RETRY_AFTER_SECONDS=5

# Retrieval
RAG_MAX_VECTOR_DISTANCE=0.56
RAG_KEYWORD_MIN_SCORE=1.0
TRAVEL_TOP_K_CONTEXT=3
TRAVEL_COLLECTION_NAME=travel_documents_v1

# VietSage storage. SQLite works for the free local pilot. Switch DATABASE_URL
# to PostgreSQL to enable pgvector without changing application code.
DATABASE_URL=sqlite:///./data/vietsage.db
CHROMA_PERSIST_DIR=./data/chroma
TRAVEL_DATA_ROOT=./data
SOURCE_STORAGE_DIR=./runtime/sources
# Venue-card catalogue (place, image, rating and review lookup for Travel
# chat). Default is the synthetic demo set. To swap in real data: validate the
# new file first (see datasets/README.md), then point this at it. A file that
# fails validation (missing licence flags) makes the loader disable cards
# rather than guess a licence.
CATALOGUE_PATH=datasets/demo/catalogue.json
CATALOGUE_ENABLED=true
EMBEDDING_DIMENSIONS=1024
EMBEDDING_QUERY_CACHE_SIZE=128
INGESTION_POLL_SECONDS=2
INGESTION_MAX_ATTEMPTS=3
# A crashed worker's processing job becomes claimable after this lease. A live
# worker renews its heartbeat while parsing and embedding.
INGESTION_JOB_LEASE_SECONDS=300
INGESTION_JOB_HEARTBEAT_SECONDS=30
# Required for document upload/deletion and the other admin routes. Leave it
# blank HERE: SETUP_AND_RUN.bat generates a fresh key into .env for each
# install. An empty key keeps those routes switched off (HTTP 503) -- it no
# longer means "open to everyone".
ADMIN_API_KEY=
HOTEL_MODE_ENABLED=false
UNIFIED_DEMO_ENABLED=true
STAY_ACCESS_TTL_HOURS=8
PRIVACY_POLICY_VERSION=demo-1.0
CHAT_LOG_ENABLED=false
CHAT_LOG_DIR=./runtime/logs
CHAT_LOG_RETENTION_DAYS=30
CHAT_TELEMETRY_ENABLED=false

# C01-F1.0 experiment availability; each browser session starts OFF.
PROACTIVE_RESEARCH_ENABLED=false
PROACTIVE_UI_TOGGLE_ENABLED=true
PROACTIVE_FIXTURE_ENABLED=false
PROACTIVE_SHADOW_ENABLED=false

# Default geography
DEFAULT_COUNTRY_CODE=VN
DEFAULT_COUNTRY_NAME=Việt Nam

APP_ENV=development
AUTH_COOKIE_NAME=vietsage_session
CSRF_COOKIE_NAME=vietsage_csrf
AUTH_SESSION_TTL_HOURS=720
# Generate a random value of at least 32 bytes for every deployed environment.
AUTH_SECRET=development-only-change-me
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Public runtime label; keep real unless the isolated demo launcher is used.
BAYAH_DATA_MODE=real

# Which other web origins may call this API from a browser, comma separated.
# The bundled PWA is served by this same application, so same-origin access -
# including through an ngrok tunnel - works without listing anything here.
# Add an entry only for a front end you serve from a different origin.
# "*" is accepted but logs a warning at startup (an error when APP_ENV is
# production) because it lets any website call every endpoint using a
# visitor's browser.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
