{
  "schema_version": "1.0",
  "suite": "normal-chat",
  "description": "Normal conversation remains text-first, natural, and free of fixed itinerary defaults.",
  "cases": [
    {
      "id": "normal-chat-greeting-is-deterministic",
      "mode": "offline",
      "probe": "chat_plan",
      "input": {"message": "Xin chào", "locale": "vi", "mode": "TRAVEL"},
      "assertions": [{"op": "nonempty", "path": "deterministic_reply"}, {"op": "null", "path": "action"}],
      "bug": {"status": "regression_guard", "root_cause": "Greeting handling must not require provider availability."}
    },
    {
      "id": "normal-chat-casual-stays-text-first",
      "mode": "offline",
      "probe": "response_prompt",
      "input": {"message": "Hôm nay mình thấy hơi mệt, nói chuyện nhẹ nhàng một chút nhé.", "locale": "vi", "context": "simple_answer"},
      "assertions": [{"op": "equals", "path": "context", "value": "simple_answer"}, {"op": "not_contains", "path": "system_prompt", "value": "GENERATIVE_UI"}, {"op": "not_contains", "path": "system_prompt", "value": "three periods"}],
      "bug": {"status": "regression_guard", "root_cause": "Simple conversation must not be routed through an itinerary presentation contract."}
    },
    {
      "id": "normal-chat-no-duration-does-not-invent-three",
      "mode": "offline",
      "probe": "structured_prompt",
      "input": {"message": "Lập kế hoạch học tiếng Anh cho người mới bắt đầu.", "context": "study_plan", "locale": "vi"},
      "assertions": [{"op": "contains", "path": "system_prompt", "value": "arbitrary cardinality"}, {"op": "contains", "path": "system_prompt", "value": "never hide a three-period default"}],
      "bug": {"status": "regression_guard", "root_cause": "Prompt contracts must state the no-duration policy instead of silently choosing three periods."}
    },
    {
      "id": "normal-chat-simple-factual-stays-text-first",
      "mode": "offline",
      "probe": "response_prompt",
      "input": {"message": "Múi giờ của Việt Nam là gì?", "locale": "vi", "context": "simple_answer"},
      "assertions": [{"op": "equals", "path": "context", "value": "simple_answer"}, {"op": "not_contains", "path": "system_prompt", "value": "artifact"}]
    },
    {
      "id": "normal-chat-technical-explanation-text-first",
      "mode": "offline",
      "probe": "response_prompt",
      "input": {"message": "Giải thích ngắn gọn cách HTTP streaming hoạt động.", "locale": "vi", "context": "simple_answer"},
      "assertions": [{"op": "equals", "path": "context", "value": "simple_answer"}, {"op": "not_contains", "path": "system_prompt", "value": "GENERATIVE_UI"}]
    },
    {
      "id": "normal-chat-travel-definition-text-first",
      "mode": "offline",
      "probe": "response_prompt",
      "input": {"message": "What is an itinerary?", "locale": "en", "context": "simple_answer"},
      "assertions": [{"op": "equals", "path": "context", "value": "simple_answer"}]
    },
    {
      "id": "normal-chat-nontravel-plan-uses-generic-periods",
      "mode": "offline",
      "probe": "structured_prompt",
      "input": {"message": "Tạo kế hoạch tập luyện 4 tuần.", "context": "schedule", "locale": "vi"},
      "assertions": [{"op": "contains", "path": "system_prompt", "value": "periods[]"}, {"op": "contains", "path": "system_prompt", "value": "Do not output maps"}]
    },
    {
      "id": "normal-chat-omitted-locale-preserves-current-language",
      "mode": "offline",
      "probe": "response_guidance",
      "input": {"message": "What time does breakfast start?", "fallback_locale": "vi"},
      "assertions": [{"op": "equals", "path": "locale", "value": "en"}, {"op": "equals", "path": "language_requested", "value": false}, {"op": "contains", "path": "guidance", "value": "Write the answer in English"}],
      "bug": {"status": "regression_guard", "root_cause": "When a request omits a locale field, current-turn language evidence must preserve English instead of resetting to the UI locale."}
    },
    {
      "id": "normal-chat-explicit-language-overrides-ui-locale",
      "mode": "offline",
      "probe": "response_guidance",
      "input": {"message": "Please answer in English, briefly and in a casual tone.", "fallback_locale": "zh-Hans"},
      "assertions": [{"op": "equals", "path": "locale", "value": "en"}, {"op": "equals", "path": "language_requested", "value": true}, {"op": "equals", "path": "detail", "value": "concise"}, {"op": "equals", "path": "tone", "value": "casual"}],
      "bug": {"status": "regression_guard", "root_cause": "An explicit language request must override the selected UI locale while preserving requested detail and tone."}
    },
    {
      "id": "normal-chat-definition-does-not-add-unrelated-offer",
      "mode": "offline",
      "probe": "response_guidance",
      "input": {"message": "What is Wi-Fi?", "fallback_locale": "en"},
      "assertions": [{"op": "contains", "path": "guidance", "value": "Address the latest request first"}, {"op": "not_contains", "path": "guidance", "value": "hotel upsell"}, {"op": "not_contains", "path": "guidance", "value": "unrelated offer"}],
      "bug": {"status": "contract_guard", "root_cause": "Prompt policy must prioritize a definition request and avoid unrelated hotel offers; model prose quality is measured separately in controlled live evidence."}
    },
    {
      "id": "normal-chat-structured-plan-failure-stays-deterministic",
      "mode": "offline",
      "probe": "structured_plan_failure_fallback",
      "input": {"message": "Create a four-week study plan", "locale": "en"},
      "assertions": [{"op": "nonempty", "path": "deterministic_reply"}, {"op": "equals", "path": "has_llm_messages", "value": false}, {"op": "null", "path": "action"}],
      "bug": {"status": "regression_guard", "root_cause": "Structured generation or parsing failure must return a deterministic grounded fallback instead of silently falling through to an unrestricted text-provider retry."}
    },
    {
      "id": "normal-chat-live-quality-explicitly-skipped",
      "mode": "live",
      "probe": "live_provider",
      "input": {"message": "Give a natural answer with no fixed greeting.", "locale": "en"},
      "assertions": [{"op": "equals", "path": "status", "value": "skipped"}],
      "bug": {"status": "live_quality_pending", "root_cause": "Provider quality requires an explicit model, seed, latency budget, and human-approved reference corpus."},
      "adapter": {"status": "pending_reviewed_provider_adapter", "runner_behavior": "skip_without_adapter", "strict_flag": "--require-live"},
      "rubric": {"must": ["answer the current request first", "honor the requested language and detail", "avoid unrelated hotel offers", "use only directly supported grounded facts for plans"], "severity": "manual_quality_gate", "evidence_ref": "docs/human/evidence/CHAT_QUALITY_2026-09-20.json"}
    }
  ]
}
