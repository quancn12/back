{
  "schema_version": "1.0",
  "suite": "artifact-routing",
  "description": "Presentation routing is task-driven and keeps unsupported contexts on the text path.",
  "cases": [
    {"id": "routing-simple-question-text", "mode": "offline", "probe": "route", "input": {"message": "Địa chỉ này ở đâu?", "has_current_artifact": false}, "assertions": [{"op": "equals", "path": "context", "value": "simple_answer"}, {"op": "equals", "path": "renderer", "value": "text"}]},
    {"id": "routing-itinerary-artifact", "mode": "offline", "probe": "route", "input": {"message": "Lập lịch trình Hội An trong 5 ngày", "has_current_artifact": false}, "assertions": [{"op": "equals", "path": "context", "value": "travel_itinerary"}, {"op": "equals", "path": "renderer", "value": "artifact"}]},
    {"id": "routing-edit-needs-artifact", "mode": "offline", "probe": "route", "input": {"message": "Đổi điểm dừng đầu tiên sang chỗ yên tĩnh hơn", "has_current_artifact": true}, "assertions": [{"op": "equals", "path": "context", "value": "travel_itinerary"}]},
    {"id": "routing-address-does-not-match-add", "mode": "offline", "probe": "route", "input": {"message": "Please address this issue", "has_current_artifact": true}, "assertions": [{"op": "equals", "path": "context", "value": "simple_answer"}, {"op": "equals", "path": "renderer", "value": "text"}]},
    {"id": "routing-comparison-stays-text", "mode": "offline", "probe": "route", "input": {"message": "So sánh hai khách sạn này", "has_current_artifact": false}, "assertions": [{"op": "equals", "path": "renderer", "value": "text"}], "bug": {"status": "regression_guard", "root_cause": "A rich renderer must be selected from task properties, not from a broad travel keyword."}},
    {"id": "generic-plan-periods-roundtrip", "mode": "offline", "probe": "generic_artifact", "input": {"context": "study_plan"}, "assertions": [{"op": "equals", "path": "context", "value": "study_plan"}, {"op": "equals", "path": "period_count", "value": 2}, {"op": "equals", "path": "title", "value": "Read chapter 2"}], "bug": {"status": "regression_guard", "root_cause": "Generic plans must use period-addressed edit contracts with the same bounds as creation."}},
    {"id": "generic-plan-server-edit-uses-period-path", "mode": "offline", "probe": "generic_plan_edit", "input": {"message": "Update the first item title"}, "assertions": [{"op": "equals", "path": "action_type", "value": "GENERATIVE_UI"}, {"op": "equals", "path": "patch_path", "value": "/periods/period_1/items/item_1/title"}], "bug": {"status": "integration_guard", "root_cause": "The server planner must accept a bounded generic currentArtifact and produce period-addressed patches through the same SSE action contract."}},
    {"id": "generic-api-sse-period-patch", "mode": "offline", "probe": "generic_api_sse", "input": {"message": "Update the first item title"}, "assertions": [{"op": "equals", "path": "status_code", "value": 200}, {"op": "equals", "path": "has_action", "value": true}, {"op": "equals", "path": "has_period_patch", "value": true}, {"op": "equals", "path": "has_done", "value": true}], "bug": {"status": "integration_guard", "root_cause": "The actual unified stream must carry generic currentArtifact edits as a validated period patch action and complete with done."}},
    {"id": "generic-study-plan-loaded-and-manually-editable", "mode": "browser", "probe": "generic_plan_manual", "input": {"reply": "", "hold_stream": false}, "assertions": [{"op": "generic_artifact_visible"}, {"op": "generic_manual_edit_visible"}]},
    {"id": "generic-study-plan-ai-patch-roundtrip", "mode": "browser", "probe": "generic_plan_patch", "input": {"reply": "", "hold_stream": false}, "assertions": [{"op": "generic_artifact_visible"}, {"op": "generic_patch_visible"}], "bug": {"status": "regression_guard", "root_cause": "Generic period artifacts must survive an AI patch action without being routed through travel-only fields."}}
  ]
}
